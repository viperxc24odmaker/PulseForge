<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Diagnostics"
            android:textColor="@color/primary" android:textSize="26sp"
            android:textStyle="bold" android:layout_marginBottom="16dp"/>

        <TextView android:id="@+id/hcDiag"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Health Connect SDK: --"
            android:textColor="@color/text" android:textSize="15sp"
            android:padding="14dp" android:background="@color/card"
            android:layout_marginBottom="10dp"/>

        <TextView android:id="@+id/hcPerms"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Health permissions: --"
            android:textColor="@color/text" android:textSize="15sp"
            android:padding="14dp" android:background="@color/card"
            android:layout_marginBottom="10dp"/>

        <TextView android:id="@+id/liveSteps"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Live step counter: waiting..."
            android:textColor="@color/text" android:textSize="15sp"
            android:padding="14dp" android:background="@color/card"
            android:layout_marginBottom="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFireNotif"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Fire Test Notification"
            android:layout_marginBottom="16dp"/>

        <TextView android:id="@+id/sensorList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Scanning sensors..."
            android:textColor="@color/muted" android:textSize="13sp"
            android:fontFamily="monospace"
            android:padding="14dp" android:background="@color/card"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
